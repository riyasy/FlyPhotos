#include <winver.h>
#include "../build/version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    FLY_VER_MAJOR,FLY_VER_MINOR,FLY_VER_PATCH,FLY_VER_BUILD
 PRODUCTVERSION FLY_VER_MAJOR,FLY_VER_MINOR,FLY_VER_PATCH,FLY_VER_BUILD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      FLY_COMPANY
            VALUE "FileDescription",  "FlyPhotos Shell and WIC Support Library"
            VALUE "FileVersion",      FLY_VER_STRING
            VALUE "InternalName",     "FlyNativeLib"
            VALUE "LegalCopyright",   FLY_COPYRIGHT
            VALUE "OriginalFilename", "FlyNativeLib.dll"
            VALUE "ProductName",      FLY_PRODUCT
            VALUE "ProductVersion",   FLY_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
