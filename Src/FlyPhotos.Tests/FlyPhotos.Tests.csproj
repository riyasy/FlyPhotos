<Project Sdk="MSTest.Sdk/4.4.1">

  <!-- The tested sources are linked in, not referenced through the WinUI/AOT app project, so the tests need
       no Windows App SDK or Win2D and run with a plain `dotnet test`. The Windows TFM is only for the WinRT
       imaging API (Windows.Graphics.Imaging) that CappedDecode uses. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- FolderListing's natural-sort P/Invoke uses LibraryImport, whose generated stub is unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\FlyPhotos\Core\Model\Enums.cs" Link="Linked\Enums.cs" />
    <Compile Include="..\FlyPhotos\Display\ImageReading\ImageFormat.cs" Link="Linked\ImageFormat.cs" />
    <Compile Include="..\FlyPhotos\Display\ImageReading\DecoderChains.cs" Link="Linked\DecoderChains.cs" />
    <Compile Include="..\FlyPhotos\Services\FolderListing.cs" Link="Linked\FolderListing.cs" />
    <Compile Include="..\FlyPhotos\Services\FolderWatcher.cs" Link="Linked\FolderWatcher.cs" />
    <Compile Include="..\FlyPhotos\Display\State\ListChange.cs" Link="Linked\ListChange.cs" />
    <Compile Include="..\FlyPhotos\Display\State\KeyWindow.cs" Link="Linked\KeyWindow.cs" />
    <Compile Include="..\FlyPhotos\Display\State\NavState.cs" Link="Linked\NavState.cs" />
    <Compile Include="..\FlyPhotos\Core\Model\LeaseCount.cs" Link="Linked\LeaseCount.cs" />
    <Compile Include="..\FlyPhotos\Display\Controllers\PrefetchPlanner.cs" Link="Linked\PrefetchPlanner.cs" />
    <Compile Include="..\FlyPhotos\Infra\Interop\NativeDdsBridge.cs" Link="Linked\NativeDdsBridge.cs" />
    <Compile Include="..\FlyPhotos\Infra\Interop\NativeHeifBridge.cs" Link="Linked\NativeHeifBridge.cs" />
    <Compile Include="..\FlyPhotos\Infra\Interop\NativeAvifBridge.cs" Link="Linked\NativeAvifBridge.cs" />
    <Compile Include="..\FlyPhotos\Display\ImageReading\CappedDecode.cs" Link="Linked\CappedDecode.cs" />
    <Compile Include="..\FlyPhotos\Display\ImageReading\PsdThumbnail.cs" Link="Linked\PsdThumbnail.cs" />
  </ItemGroup>

  <!-- DdsDecoderTests and HeifDecoderTests call the real decoders, so their committed x64 builds (and
       FlyNativeLibHeif's vcpkg dependencies) sit next to the test assembly. These tests therefore run in
       an x64 process only. -->
  <ItemGroup>
    <None Include="..\FlyPhotos\External\x64\FlyNativeLibDds.dll;..\FlyPhotos\External\x64\FlyNativeLibHeif.dll;..\FlyPhotos\External\x64\heif.dll;..\FlyPhotos\External\x64\libde265.dll;..\FlyPhotos\External\x64\dav1d.dll;..\FlyPhotos\External\x64\libpng16.dll;..\FlyPhotos\External\x64\z.dll"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- HEIC/AVIF fixtures; make_fixtures.py next to them regenerates them. -->
    <None Update="TestData\**\*.heic;TestData\**\*.avif" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
