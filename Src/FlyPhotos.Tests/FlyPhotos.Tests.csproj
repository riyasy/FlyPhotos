<Project Sdk="MSTest.Sdk/4.4.1">

  <!-- The tests reference the app itself (its internals are visible to them), so the display pipeline — photo list,
       prefetch cache, controller — runs here with real Win2D bitmaps on a headless device (no window, no XAML).
       Self-contained Windows App SDK, like the app, so no runtime install is needed. Build with -p:Platform=x64. -->
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlyPhotos\FlyPhotos.csproj" />
  </ItemGroup>

  <!-- HEIC/AVIF fixtures; make_fixtures.py next to them regenerates them. The native decoders come with the app's
       External\<platform> content. -->
  <ItemGroup>
    <None Update="TestData\**\*.heic;TestData\**\*.avif" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
