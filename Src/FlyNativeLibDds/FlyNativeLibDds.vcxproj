  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
    <IncludePath>$(ProjectDir)..\build_directxtex\vcpkg_installed_arm64\arm64-windows-static\include;$(IncludePath)</IncludePath>
