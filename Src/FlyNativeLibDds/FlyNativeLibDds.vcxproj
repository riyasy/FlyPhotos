      <PreprocessorDefinitions>NDEBUG;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <!-- /PDBALTPATH:%_PDB% embeds just the PDB filename instead of the full build-machine
           path, which would otherwise leak a local directory into every shipped binary.
           /Brepro drops build timestamps so the output is byte-reproducible.
           The %25 are MSBuild-escaped percent signs; the linker receives %_PDB%. -->
      <AdditionalOptions>/PDBALTPATH:%25_PDB%25 /Brepro %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
