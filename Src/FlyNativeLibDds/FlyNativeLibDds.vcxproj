  <!-- DirectXTex (+ header-only DirectXMath) come from vcpkg via ..\build_directxtex, installed by
       01_vcpkg_libheif.ps1 with all-static triplets: DirectXTex.lib is linked into this DLL,
       nothing extra ships. Release uses the release-only *-static-release triplets; Debug needs the
       built-in *-windows-static triplets (01 script with -IncludeDebug) for /MTd-matching libs. -->
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\$(Platform)\$(Configuration)\</OutDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <IncludePath>$(ProjectDir)..\build_directxtex\vcpkg_installed_x64\x64-windows-static\include;$(IncludePath)</IncludePath>
