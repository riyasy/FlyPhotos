<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FlyPhotos.UI.Controls.RenameFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Name="ShrugStoryboard">
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="RenamePanel"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.06" Value="8" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="-8" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="5" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="-5" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <StackPanel x:Name="RenamePanel" Orientation="Horizontal" Spacing="8">
        <StackPanel.RenderTransform>
            <TranslateTransform />
        </StackPanel.RenderTransform>
        <TextBox x:Name="RenameTextBox" Width="220" KeyDown="RenameTextBox_OnKeyDown" />
        <TextBlock x:Name="RenameExtensionText" VerticalAlignment="Center" />
        <Button x:Name="RenameOkButton" Click="RenameOk_OnClick" />
    </StackPanel>
</UserControl>
