<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FlyPhotos.UI.Views.ShortcutEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FlyPhotos.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:FlyPhotos.UI.Views"
    DefaultButton="Close"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Style x:Key="DialogChipButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource FluentIcons}" />
            <Setter Property="FontSize" Value="10" />
        </Style>
    </ContentDialog.Resources>

    <!--
        Fixed width, not MinWidth: the capture text, the conflict message and the chip list all
        change as the user works, and each one reports the width it wants unwrapped, so the dialog
        used to resize on every keystroke and every chip removed. Pinned, they wrap instead.
    -->
    <StackPanel Width="400" Spacing="10">

        <TextBlock x:Uid="TextShortcutCurrent" Style="{StaticResource BodyStrongTextBlockStyle}" />

        <ItemsControl ItemsSource="{x:Bind Row.Keys}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="views:ShortcutKey">
                    <Border
                        Padding="10,4,6,4"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="13"
                                Text="{x:Bind Text}" />
                            <Button
                                x:Uid="ButtonShortcutRemove"
                                Click="ChipRemove_OnClick"
                                Content="&#xE711;"
                                Style="{StaticResource DialogChipButtonStyle}"
                                Tag="{x:Bind}">
                                <ToolTipService.ToolTip>
                                    <ToolTip x:Uid="ShortcutRemoveToolTip" />
                                </ToolTipService.ToolTip>
                            </Button>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
            x:Uid="TextShortcutNoneAssigned"
            Opacity="0.6"
            Visibility="{x:Bind Row.NoKeysVisibility, Mode=OneWay}" />

        <Border
            Height="1"
            Margin="0,4,0,4"
            Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <TextBlock x:Uid="TextShortcutCapturePrompt" TextWrapping="Wrap" />

        <!--
            A focusable ContentControl rather than a Button: while capturing we must see every key,
            and a Button would swallow Space and Enter before they reach our handler. Capture is
            active only while this has focus, and Tab is deliberately left unhandled so keyboard
            users can always move on to the chips and the reset button.
        -->
        <ContentControl
            x:Name="CaptureBox"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            IsTabStop="True"
            UseSystemFocusVisuals="True">
            <Border
                MinHeight="60"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="8">
                <!--  Text is set from code: it changes as capture starts, stops and rejects.  -->
                <TextBlock
                    x:Name="TxtCapture"
                    Margin="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="18"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Border>
        </ContentControl>

        <!--  Live region so a screen reader announces a conflict without focus having to move.  -->
        <InfoBar
            x:Name="StatusBar"
            AutomationProperties.LiveSetting="Assertive"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button
                    x:Name="ButtonReassign"
                    x:Uid="ButtonShortcutReassign"
                    Click="ButtonReassign_OnClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Button
            x:Uid="ButtonShortcutResetDefault"
            HorizontalAlignment="Left"
            Click="ButtonResetDefault_OnClick" />

    </StackPanel>
</ContentDialog>
