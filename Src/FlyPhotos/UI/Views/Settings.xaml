<Window
    x:Class="FlyPhotos.UI.Views.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FlyPhotos.Infra.Configuration"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:FlyPhotos.Core.Model"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:views="using:FlyPhotos.UI.Views"
    mc:Ignorable="d">
    <Grid x:Name="MainLayout" Background="Transparent">
        <Grid.Resources>
            <!--
                Glyph-only buttons. WinUI's default Button padding (11,5,11,6) and MinWidth/MinHeight
                of 32 leave a fixed-size icon button no room for its glyph, so all three are zeroed
                and the size is set explicitly.
            -->
            <Style x:Key="ShortcutIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource FluentIcons}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="ShortcutChipButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2,0,0,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource FluentIcons}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="FixedMouseActionTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>
        <Pivot x:Uid="SettingsPage">
            <PivotItem x:Uid="SettingsPivotItemGeneral">
                <ScrollViewer>
                    <ScrollViewer.Resources>
                        <Flyout x:Name="ColorPickerFlyout" Placement="Right">
                            <!--  A StackPanel organizes the content of the flyout  -->
                            <StackPanel MinWidth="300" Spacing="10">
                                <ColorPicker
                                    x:Name="FlyoutColorPicker"
                                    ColorSpectrumShape="Ring"
                                    IsAlphaEnabled="False"
                                    IsHexInputVisible="True" />
                                <!--  Buttons to confirm or cancel the selection  -->
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Button x:Uid="ColorPickerFlyoutOkButton" Click="ColorFlyOutOkButton_Click" />
                                    <Button x:Uid="ColorPickerFlyoutCancelButton" Click="ColorFlyOutCancelButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </ScrollViewer.Resources>

                    <StackPanel Margin="0,5,15,30" Orientation="Vertical">
                        <controls:SettingsCard
                            x:Name="SettingsCardDeveloperSupport"
                            x:Uid="SettingsCardDeveloperSupport"
                            Margin="0,5,0,0">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon
                                    x:Name="HeartIcon"
                                    MinWidth="32"
                                    MinHeight="32"
                                    FontFamily="{StaticResource FluentIcons}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xEB51;" />
                            </controls:SettingsCard.HeaderIcon>
                            <HyperlinkButton x:Uid="DonateButton" NavigateUri="https://github.com/sponsors/riyasy" />
                        </controls:SettingsCard>

                        <!--  *****************  -->

                        <TextBlock
                            x:Uid="TextBlockStartupAndAppearance"
                            Margin="0,20,0,0"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <controls:SettingsCard
                            x:Name="SettingsCardLanguage"
                            x:Uid="SettingsCardLanguage"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE774;, FontFamily={StaticResource FluentIcons}}">
                            <ComboBox
                                x:Name="ComboLanguage"
                                MinWidth="200"
                                HorizontalAlignment="Right">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="model:LanguageInfo">
                                        <TextBlock Text="{x:Bind DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Name="SettingsCardTheme"
                            x:Uid="SettingsCardTheme"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE790;, FontFamily={StaticResource FluentIcons}}">
                            <ComboBox
                                x:Name="ComboTheme"
                                MinWidth="150"
                                SelectedIndex="0">
                                <ComboBoxItem x:Uid="ComboThemeItemDefault" />
                                <ComboBoxItem x:Uid="ComboThemeItemDark" />
                                <ComboBoxItem x:Uid="ComboThemeItemLight" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <controls:SettingsExpander
                            x:Name="SettingsCardWindowBackground"
                            x:Uid="SettingsCardWindowBackground"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE70A;, FontFamily={StaticResource FluentIcons}}">
                            <ComboBox
                                x:Name="ComboBackGround"
                                MinWidth="150"
                                HorizontalAlignment="Right"
                                SelectedIndex="0">
                                <ComboBoxItem x:Uid="ComboBackgroundItemTransparent" />
                                <ComboBoxItem x:Uid="ComboBackgroundItemFrozen" />
                                <ComboBoxItem x:Uid="ComboBackgroundItemAcrylic" />
                                <ComboBoxItem x:Uid="ComboBackgroundItemAcrylicThin" />
                                <ComboBoxItem x:Uid="ComboBackgroundItemMica" />
                                <ComboBoxItem x:Uid="ComboBackgroundItemMicaAlt" />
                                <ComboBoxItem x:Uid="ComboBackgroundItemNone" />
                                <ComboBoxItem x:Uid="ComboBackgroundItemCustom" />
                            </ComboBox>
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard
                                    x:Name="SettingsCardTransparentBackgroundIntensity"
                                    x:Uid="SettingsCardTransparentBackgroundIntensity"
                                    IsEnabled="{x:Bind ShouldEnableTransparencySlider(ComboBackGround.SelectedIndex), Mode=OneWay}">
                                    <Slider
                                        x:Name="SliderTransparentBackgroundIntensity"
                                        MinWidth="150"
                                        Maximum="90"
                                        Minimum="20"
                                        SmallChange="10"
                                        StepFrequency="10"
                                        Value="60" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    x:Name="SettingsCardWindowBackgroundColor"
                                    x:Uid="SettingsCardWindowBackgroundColor"
                                    IsEnabled="{x:Bind ShouldEnableBackgroundColor(ComboBackGround.SelectedIndex), Mode=OneWay}">
                                    <Button
                                        x:Name="ButtonSetWindowBackgroundColor"
                                        HorizontalAlignment="Right"
                                        FlyoutBase.AttachedFlyout="{StaticResource ColorPickerFlyout}"
                                        Tapped="RectWindowBackground_Tapped">
                                        <ToolTipService.ToolTip>
                                            <ToolTip x:Uid="ButtonSetWindowBackgroundColorToolTip" />
                                        </ToolTipService.ToolTip>
                                        <Button.Content>
                                            <Rectangle
                                                x:Name="RectWindowBackground"
                                                Width="20"
                                                Height="20"
                                                Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                                StrokeThickness="1" />
                                        </Button.Content>
                                    </Button>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>

                        <controls:SettingsCard
                            x:Name="SettingsCardWindowLaunchMode"
                            x:Uid="SettingsCardWindowLaunchMode"
                            Margin="0,5,0,0"
                            Description="{x:Bind LaunchModeDescription(ComboWindowLaunchMode.SelectedIndex), Mode=OneWay}"
                            HeaderIcon="{ui:FontIcon Glyph=&#xEC77;, FontFamily={StaticResource FluentIcons}}">
                            <ComboBox
                                x:Name="ComboWindowLaunchMode"
                                MinWidth="150"
                                HorizontalAlignment="Right">
                                <ComboBoxItem x:Uid="ComboWindowLaunchModeItemMaximized" />
                                <ComboBoxItem x:Uid="ComboWindowLaunchModeItemFullScreen" />
                                <ComboBoxItem x:Uid="ComboWindowLaunchModeItemLastWindowState" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Name="SettingsCardOpenExitZoom"
                            x:Uid="SettingsCardOpenExitZoom"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE740;, FontFamily={StaticResource FluentIcons}}">
                            <ToggleSwitch x:Name="ButtonOpenExitZoom" />
                        </controls:SettingsCard>

                        <!--  *****************  -->

                        <TextBlock
                            x:Uid="TextBlockPhotoDisplay"
                            Margin="0,20,0,0"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <controls:SettingsExpander
                            x:Name="SettingsCardImageFitPercentage"
                            x:Uid="SettingsCardImageFitPercentage"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE9A6;, FontFamily={StaticResource FluentIcons}}">
                            <Slider
                                x:Name="SliderImageFitPercentage"
                                MinWidth="150"
                                Maximum="100"
                                Minimum="50"
                                SmallChange="10"
                                StepFrequency="10" />
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard x:Name="SettingsCardStretchSmallImages" x:Uid="SettingsCardStretchSmallImages">
                                    <ToggleSwitch x:Name="ButtonStretchSmallImages" />
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>

                        <controls:SettingsCard
                            x:Name="SettingsCardImageScalingQuality"
                            x:Uid="SettingsCardImageScalingQuality"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE794;, FontFamily={StaticResource FluentIcons}}">
                            <ComboBox
                                x:Name="ComboImageScalingQuality"
                                MinWidth="150"
                                HorizontalAlignment="Right">
                                <ComboBoxItem x:Uid="ComboImageScalingQualityItemNearestNeighbor" />
                                <ComboBoxItem x:Uid="ComboImageScalingQualityItemBilinear" />
                                <ComboBoxItem x:Uid="ComboImageScalingQualityItemAnisotropic" />
                                <ComboBoxItem x:Uid="ComboImageScalingQualityItemHighQualityCubic" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="SettingsCardPanZoomNavBehaviour"
                            x:Uid="SettingsCardPanZoomNavBehaviour"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE7C5;, FontFamily={StaticResource FluentIcons}}">
                            <ComboBox
                                x:Name="ComboPanZoomNavBehaviour"
                                MinWidth="150"
                                HorizontalAlignment="Right">
                                <ComboBoxItem x:Uid="ComboPanZoomItemReset" />
                                <ComboBoxItem x:Uid="ComboPanZoomItemRemember" />
                                <ComboBoxItem x:Uid="ComboPanZoomItemRetain" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Name="SettingsCardShowCheckeredBackground"
                            x:Uid="SettingsCardShowCheckeredBackground"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE80A;, FontFamily={StaticResource FluentIcons}}">
                            <ToggleSwitch x:Name="ButtonShowCheckeredBackground" />
                        </controls:SettingsCard>

                        <!--  *****************  -->

                        <TextBlock
                            x:Uid="TextBlockBehaviour"
                            Margin="0,20,0,0"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <controls:SettingsCard
                            x:Name="SettingsCardConfirmBeforeDelete"
                            x:Uid="SettingsCardConfirmBeforeDelete"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE74D;, FontFamily={StaticResource FluentIcons}}">
                            <ToggleSwitch x:Name="ButtonConfirmBeforeDelete" />
                        </controls:SettingsCard>

                        <!--  *****************  -->

                        <TextBlock
                            x:Uid="TextBlockUIControls"
                            Margin="0,20,0,0"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <controls:SettingsCard
                            x:Name="SettingsCardShowFileName"
                            x:Uid="SettingsCardShowFileName"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xED1E;, FontFamily={StaticResource FluentIcons}}">
                            <ToggleSwitch x:Name="ButtonShowFileName" />
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Name="SettingsCardShowImageDimensions"
                            x:Uid="SettingsCardShowImageDimensions"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xED1E;, FontFamily={StaticResource FluentIcons}}">
                            <ToggleSwitch x:Name="ButtonShowImageDimensions" />
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Name="SettingsCardShowCacheStatusExpander"
                            x:Uid="SettingsCardShowCacheStatusExpander"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xED1E;, FontFamily={StaticResource FluentIcons}}">
                            <ToggleSwitch x:Name="ButtonShowCacheStatusExpander" />
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            x:Name="SettingsCardShowZoomPercent"
                            x:Uid="SettingsCardShowZoomPercent"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE94C;, FontFamily={StaticResource FluentIcons}}">
                            <ToggleSwitch x:Name="ButtonShowZoomPercent" />
                        </controls:SettingsCard>

                        <controls:SettingsExpander
                            x:Name="SettingsCardExternalShortcuts"
                            x:Uid="SettingsCardExternalShortcuts"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE8A7;, FontFamily={StaticResource FluentIcons}}">
                            <ToggleSwitch x:Name="ButtonEnableExternalShortcut" HorizontalAlignment="Right" />
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard
                                    x:Name="SettingsCardExternalApps"
                                    x:Uid="SettingsCardExternalApps"
                                    IsEnabled="{x:Bind ButtonEnableExternalShortcut.IsOn, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            x:Name="BtnShortcut1"
                                            Height="50"
                                            Margin="2"
                                            Click="OnShortcutButtonClick">
                                            <FontIcon Glyph="&#xE8E5;" FontFamily="{StaticResource FluentIcons}" />
                                        </Button>
                                        <Button
                                            x:Name="BtnShortcut2"
                                            Height="50"
                                            Margin="2"
                                            Click="OnShortcutButtonClick">
                                            <FontIcon Glyph="&#xE8E5;" FontFamily="{StaticResource FluentIcons}" />
                                        </Button>
                                        <Button
                                            x:Name="BtnShortcut3"
                                            Height="50"
                                            Margin="2"
                                            Click="OnShortcutButtonClick">
                                            <FontIcon Glyph="&#xE8E5;" FontFamily="{StaticResource FluentIcons}" />
                                        </Button>
                                        <Button
                                            x:Name="BtnShortcut4"
                                            Height="50"
                                            Margin="2"
                                            Click="OnShortcutButtonClick">
                                            <FontIcon Glyph="&#xE8E5;" FontFamily="{StaticResource FluentIcons}" />
                                        </Button>
                                    </StackPanel>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>

                        <controls:SettingsExpander
                            x:Name="SettingsCardShowThumbnail"
                            x:Uid="SettingsCardShowThumbnail"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xF597;, FontFamily={StaticResource FluentIcons}}">
                            <ToggleSwitch x:Name="ButtonShowThumbnail" HorizontalAlignment="Right" />
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard
                                    x:Name="SettingsCardThumbnailAnimation"
                                    x:Uid="SettingsCardThumbnailAnimation"
                                    HeaderIcon="{ui:FontIcon Glyph=&#xF4A5;, FontFamily={StaticResource FluentIcons}}"
                                    IsEnabled="{x:Bind ButtonShowThumbnail.IsOn, Mode=OneWay}">
                                    <ToggleSwitch x:Name="ButtonThumbnailAnimation" HorizontalAlignment="Right" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    x:Name="SettingsCardThumbnailSize"
                                    x:Uid="SettingsCardThumbnailSize"
                                    HeaderIcon="{ui:FontIcon Glyph=&#xE620;, FontFamily={StaticResource FluentIcons}}"
                                    IsEnabled="{x:Bind ButtonShowThumbnail.IsOn, Mode=OneWay}">
                                    <Slider
                                        x:Name="SliderThumbnailSize"
                                        MinWidth="150"
                                        Maximum="60"
                                        Minimum="30"
                                        SmallChange="10"
                                        StepFrequency="10"
                                        Value="40" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    x:Name="SettingsCardThumbnailSelectionColor"
                                    x:Uid="SettingsCardThumbnailSelectionColor"
                                    HeaderIcon="{ui:FontIcon Glyph=&#xE790;, FontFamily={StaticResource FluentIcons}}"
                                    IsEnabled="{x:Bind ButtonShowThumbnail.IsOn, Mode=OneWay}">
                                    <Button
                                        x:Name="ButtonSetThumbnailSelColor"
                                        HorizontalAlignment="Right"
                                        FlyoutBase.AttachedFlyout="{StaticResource ColorPickerFlyout}"
                                        Tapped="RectThumbnailSelection_Tapped">
                                        <ToolTipService.ToolTip>
                                            <ToolTip x:Uid="ButtonSetThumbnailSelColorToolTip" />
                                        </ToolTipService.ToolTip>
                                        <Button.Content>
                                            <Rectangle
                                                x:Name="RectThumbnailSelection"
                                                Width="20"
                                                Height="20"
                                                StrokeThickness="3" />
                                        </Button.Content>
                                    </Button>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>

                        <!--  *****************  -->

                        <TextBlock
                            x:Uid="TextBlockAutoFadeSettings"
                            Margin="0,20,0,0"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <controls:SettingsExpander
                            x:Name="SettingsCardFadeControls"
                            x:Uid="SettingsCardFadeControls"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE754;, FontFamily={StaticResource FluentIcons}}">
                            <ToggleSwitch x:Name="ButtonEnableAutoFade" HorizontalAlignment="Right" />
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard
                                    x:Name="SettingsCardFadeIntensity"
                                    x:Uid="SettingsCardFadeIntensity"
                                    IsEnabled="{x:Bind ButtonEnableAutoFade.IsOn, Mode=OneWay}">
                                    <Slider
                                        x:Name="SliderFadeIntensity"
                                        MinWidth="150"
                                        Maximum="100"
                                        Minimum="30"
                                        SmallChange="10"
                                        StepFrequency="10"
                                        Value="50" />
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                        <controls:SettingsCard
                            x:Name="SettingsCardAutoHideMouse"
                            x:Uid="SettingsCardAutoHideMouse"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xED1A;, FontFamily={StaticResource FluentIcons}}">
                            <ToggleSwitch x:Name="ButtonEnableAutoHideMouse" HorizontalAlignment="Right" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="SettingsCardAutoHideCaptionButtons"
                            x:Uid="SettingsCardAutoHideCaptionButtons"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xED1A;, FontFamily={StaticResource FluentIcons}}">
                            <ToggleSwitch x:Name="ButtonEnableAutoHideCaptionButtons" HorizontalAlignment="Right" />
                        </controls:SettingsCard>

                        <!--  *****************  -->

                        <TextBlock
                            x:Uid="TextBlockCaching"
                            Margin="0,20,0,0"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <controls:SettingsCard
                            x:Name="SettingsCardLowResCache"
                            x:Uid="SettingsCardLowResCache"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xF16A;, FontFamily={StaticResource FluentIcons}}">
                            <Slider
                                x:Name="SliderLowResCacheSize"
                                MinWidth="150"
                                Maximum="300"
                                Minimum="50"
                                SmallChange="10"
                                StepFrequency="10"
                                Value="300" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="SettingsCardHighResCache"
                            x:Uid="SettingsCardHighResCache"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xF16A;, FontFamily={StaticResource FluentIcons}}">
                            <Slider
                                x:Name="SliderHighResCacheSize"
                                MinWidth="150"
                                Maximum="3"
                                Minimum="1"
                                SmallChange="1"
                                StepFrequency="1"
                                Value="2" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Name="SettingsCardClearDiskCache"
                            x:Uid="SettingsCardClearDiskCache"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE74D;, FontFamily={StaticResource FluentIcons}}">
                            <Button
                                x:Name="ButtonClearDiskCache"
                                x:Uid="ButtonClearDiskCache"
                                Click="ButtonClearDiskCache_OnClick" />
                        </controls:SettingsCard>

                        <!--  *****************  -->

                        <TextBlock
                            x:Uid="TextBlockAdvanced"
                            Margin="0,20,0,0"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <controls:SettingsExpander
                            x:Name="SettingsCardDecodeRawData"
                            x:Uid="SettingsCardDecodeRawData"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE722;, FontFamily={StaticResource FluentIcons}}">
                            <ToggleSwitch x:Name="ButtonDecodeRawData" />
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard x:Name="SettingsCardDecoderPriority" x:Uid="SettingsCardDecoderPriority">
                                    <ListView
                                        x:Name="PriorityListView"
                                        Width="Auto"
                                        HorizontalAlignment="Left"
                                        AllowDrop="True"
                                        IsEnabled="{x:Bind ButtonDecodeRawData.IsOn, Mode=OneWay}"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CanDragItems="True"
                                        CanReorderItems="True"
                                        CornerRadius="8"
                                        ItemsSource="{x:Bind local:AppConfig.Settings.RawDecoderPriority}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.HorizontalScrollMode="Enabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollMode="Disabled">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="model:RawDecoder">
                                                <StackPanel
                                                    Padding="10"
                                                    Background="Transparent"
                                                    Orientation="Horizontal">
                                                    <!--  We can keep the same icon or change it to a horizontal drag handle  -->
                                                    <FontIcon
                                                        Margin="0,0,12,0"
                                                        FontFamily="{StaticResource FluentIcons}"
                                                        FontSize="16"
                                                        Glyph="&#xE76F;" />
                                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>

                        <TeachingTip
                            x:Name="RawDecodeTeachingTip"
                            x:Uid="RawDecodeTeachingTip"
                            IsLightDismissEnabled="True" />

                        <controls:SettingsCard
                            x:Name="SettingsCardAllowMultiInstance"
                            x:Uid="SettingsCardAllowMultiInstance"
                            Margin="0,5,0,0"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE7AA;, FontFamily={StaticResource FluentIcons}}">
                            <ToggleSwitch x:Name="ButtonAllowMultiInstance" />
                        </controls:SettingsCard>

                        <!--  *****************  -->

                        <TextBlock
                            x:Uid="TextBlockLog"
                            Margin="0,20,0,0"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <controls:SettingsCard
                            x:Name="SettingsCardLog"
                            x:Uid="SettingsCardLog"
                            Margin="0,5,0,30"
                            HeaderIcon="{ui:FontIcon Glyph=&#xE81C;, FontFamily={StaticResource FluentIcons}}">
                            <StackPanel Orientation="Vertical">
                                <Button
                                    x:Name="ButtonOpenLog"
                                    x:Uid="ButtonOpenLog"
                                    Click="ButtonOpenLog_OnClick" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!--
                Command names, hints and key names come from the catalog in code, which resolves them
                through L.Get; everything static on the page uses x:Uid as usual.
            -->
            <PivotItem x:Uid="SettingsPivotItemKeyboard">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Margin="0,8,15,4"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox
                            x:Uid="ShortcutSearchBox"
                            QueryIcon="Find"
                            TextChanged="ShortcutSearchBox_OnTextChanged" />
                        <Button
                            x:Uid="ButtonResetAllShortcuts"
                            Grid.Column="1"
                            Click="ButtonResetAllShortcuts_OnClick" />
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel Margin="0,5,15,30" Orientation="Vertical">

                            <TextBlock
                                x:Name="TxtNoShortcutResults"
                                x:Uid="TxtNoShortcutResults"
                                Margin="0,24,0,0"
                                Opacity="0.7"
                                Visibility="Collapsed" />

                            <ItemsControl x:Name="ShortcutGroupsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="views:ShortcutGroup">
                                        <StackPanel Orientation="Vertical" Visibility="{x:Bind GroupVisibility, Mode=OneWay}">
                                            <TextBlock
                                                Margin="0,20,0,0"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Name}" />
                                            <ItemsControl Margin="0,5,0,0" ItemsSource="{x:Bind Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="views:ShortcutRow">
                                                        <controls:SettingsCard
                                                            Margin="0,0,0,2"
                                                            Description="{x:Bind Description}"
                                                            Header="{x:Bind Name}"
                                                            Visibility="{x:Bind RowVisibility, Mode=OneWay}">
                                                            <controls:SettingsCard.HeaderIcon>
                                                                <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="{x:Bind Glyph}" />
                                                            </controls:SettingsCard.HeaderIcon>

                                                            <!--
                                                                Horizontal StackPanel, not a wrap panel: WinUI has no built-in
                                                                WrapPanel and the toolkit's lives in a package this project does
                                                                not reference. Zoom is the widest row at 4 chords, and SettingsCard
                                                                drops this block below the header at narrow widths, which is what
                                                                keeps it usable at high scaling. Revisit if a 5th ever lands.
                                                            -->
                                                            <StackPanel
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal"
                                                                Spacing="4">
                                                                <TextBlock
                                                                    x:Uid="TextShortcutNoKeys"
                                                                    VerticalAlignment="Center"
                                                                    Opacity="0.6"
                                                                    Visibility="{x:Bind NoKeysVisibility, Mode=OneWay}" />

                                                                <ItemsControl ItemsSource="{x:Bind Keys}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="views:ShortcutKey">
                                                                            <Border
                                                                                Padding="8,3,8,3"
                                                                                VerticalAlignment="Center"
                                                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4">
                                                                                <TextBlock
                                                                                    VerticalAlignment="Center"
                                                                                    FontFamily="Consolas"
                                                                                    FontSize="13"
                                                                                    Text="{x:Bind Text}" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!--  Add, remove and reset all live inside the edit dialog.  -->
                                                                <Button
                                                                    x:Uid="ButtonShortcutEdit"
                                                                    Click="ShortcutEdit_OnClick"
                                                                    Content="&#xE70F;"
                                                                    Style="{StaticResource ShortcutIconButtonStyle}"
                                                                    Tag="{x:Bind}"
                                                                    Visibility="{x:Bind EditableVisibility}">
                                                                    <ToolTipService.ToolTip>
                                                                        <ToolTip x:Uid="ShortcutEditToolTip" />
                                                                    </ToolTipService.ToolTip>
                                                                </Button>
                                                            </StackPanel>
                                                        </controls:SettingsCard>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <!--
                Mouse: pickers, not capture. See design doc section 5. Rendered from MouseCatalog
                rather than hand-written, so a new row costs no XAML. Its own tab because the
                Keyboard tab's search box and Reset all apply to key bindings only. Resource keys
                are unchanged from when these were hand-written cards.
            -->
            <PivotItem x:Uid="SettingsPivotItemMouse">
                <ScrollViewer>
                    <ItemsControl x:Name="MouseRowsList" Margin="0,5,15,30">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="views:MouseRow">
                                <controls:SettingsCard
                                    Margin="0,0,0,2"
                                    Description="{x:Bind Description}"
                                    Header="{x:Bind Header}">
                                    <controls:SettingsCard.HeaderIcon>
                                        <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE962;" />
                                    </controls:SettingsCard.HeaderIcon>

                                    <!--  A row is one or the other; the unused half stays collapsed.  -->
                                    <Grid>
                                        <TextBlock
                                            Style="{StaticResource FixedMouseActionTextStyle}"
                                            Text="{x:Bind FixedAction, Mode=OneWay}"
                                            Visibility="{x:Bind FixedVisibility}" />
                                        <ComboBox
                                            MinWidth="170"
                                            ItemsSource="{x:Bind Options}"
                                            SelectedIndex="{x:Bind SelectedIndex}"
                                            SelectionChanged="MouseOption_OnSelectionChanged"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind PickerVisibility}" />
                                    </Grid>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </PivotItem>

            <PivotItem x:Uid="SettingsPivotItemCodecs">
                <ScrollViewer>
                    <StackPanel Margin="0,5,15,30" Orientation="Vertical">
                        <TextBlock
                            x:Uid="TextBlockCodecsInfo"
                            Margin="0,10,0,0"
                            Style="{StaticResource BodyTextBlockStyle}" />
                        <ListView x:Name="ListViewCodecs" Margin="0,10,0,0">
                            <ListView.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Padding="16,0,12,0" ColumnDefinitions="*,120,2*">
                                        <TextBlock x:Uid="HeaderCodec" FontWeight="Bold" />
                                        <TextBlock
                                            x:Uid="HeaderType"
                                            Grid.Column="1"
                                            FontWeight="Bold" />
                                        <TextBlock
                                            x:Uid="HeaderExtensions"
                                            Grid.Column="2"
                                            FontWeight="Bold" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.HeaderTemplate>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:CodecInfo">
                                    <Grid Padding="4" ColumnDefinitions="*,120,2*">
                                        <TextBlock Text="{x:Bind FriendlyName}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Type}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind ExtensionsDisplay}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem x:Uid="SettingsPivotItemAbout">
                <StackPanel Orientation="Vertical">
                    <controls:SettingsCard
                        x:Name="SettingsCardVersion"
                        x:Uid="SettingsCardVersion"
                        Margin="0,5,0,0"
                        HeaderIcon="{ui:FontIcon Glyph=&#xF133;, FontFamily={StaticResource FluentIcons}}">
                        <HyperlinkButton
                            x:Name="BtnCheckVersion"
                            x:Uid="BtnCheckVersion"
                            NavigateUri="https://github.com/riyasy/FlyPhotos/releases" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        x:Name="SettingsCardSourceCode"
                        x:Uid="SettingsCardSourceCode"
                        Margin="0,5,0,0">
                        <controls:SettingsCard.HeaderIcon>
                            <PathIcon Data="M15,3C8.373,3,3,8.373,3,15c0,5.623,3.872,10.328,9.092,11.63C12.036,26.468,12,26.28,12,26.047v-2.051 c-0.487,0-1.303,0-1.508,0c-0.821,0-1.551-0.353-1.905-1.009c-0.393-0.729-0.461-1.844-1.435-2.526 c-0.289-0.227-0.069-0.486,0.264-0.451c0.615,0.174,1.125,0.596,1.605,1.222c0.478,0.627,0.703,0.769,1.596,0.769 c0.433,0,1.081-0.025,1.691-0.121c0.328-0.833,0.895-1.6,1.588-1.962c-3.996-0.411-5.903-2.399-5.903-5.098 c0-1.162,0.495-2.286,1.336-3.233C9.053,10.647,8.706,8.73,9.435,8c1.798,0,2.885,1.166,3.146,1.481C13.477,9.174,14.461,9,15.495,9 c1.036,0,2.024,0.174,2.922,0.483C18.675,9.17,19.763,8,21.565,8c0.732,0.731,0.381,2.656,0.102,3.594 c0.836,0.945,1.328,2.066,1.328,3.226c0,2.697-1.904,4.684-5.894,5.097C18.199,20.49,19,22.1,19,23.313v2.734 c0,0.104-0.023,0.179-0.035,0.268C23.641,24.676,27,20.236,27,15C27,8.373,21.627,3,15,3z" />
                        </controls:SettingsCard.HeaderIcon>
                        <HyperlinkButton x:Uid="BtnGitHubRepo" NavigateUri="https://github.com/riyasy/FlyPhotos" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        x:Name="SettingsCardReportBugs"
                        x:Uid="SettingsCardReportBugs"
                        Margin="0,5,0,0"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE730;, FontFamily={StaticResource FluentIcons}}">
                        <HyperlinkButton x:Uid="BtnReportBugs" NavigateUri="https://github.com/riyasy/FlyPhotos/issues" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        x:Name="SettingsCardCredits"
                        x:Uid="SettingsCardCredits"
                        Margin="0,5,0,0"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE728;, FontFamily={StaticResource FluentIcons}}">
                        <HyperlinkButton x:Uid="BtnThirdPartyLicenses" Click="ButtonThirdPartyLicenses_Click" />
                    </controls:SettingsCard>
                </StackPanel>
            </PivotItem>
        </Pivot>
    </Grid>
</Window>
